{
  "name": "slidev-addon-sandpack",
  "type": "module",
  "version": "0.5.1",
  "description": "Build stepped, multi-file Sandpack live-code demos in Slidev from readable Markdown.",
  "author": "Nir Tamir",
  "license": "MIT",
  "homepage": "https://github.com/nirtamir2/slidev-addon-sandpack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirtamir2/slidev-addon-sandpack.git"
  },
  "bugs": {
    "url": "https://github.com/nirtamir2/slidev-addon-sandpack/issues"
  },
  "keywords": [
    "slidev",
    "slidev-addon",
    "sandpack",
    "codesandbox",
    "live-code",
    "presentation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./components/*.vue",
    "./styles/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "components",
    "dist",
    "docs",
    "setup",
    "styles"
  ],
  "engines": {
    "node": ">=24.0.0",
    "slidev": ">=52.1.0"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "audit:prod": "pnpm audit --prod --audit-level high",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "build:example": "pnpm run build && slidev build example/slides.md --out example-dist",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:run && pnpm run build:example",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm run build && vitest",
    "test:pack": "node scripts/test-pack.mjs",
    "test:run": "pnpm run build && vitest run",
    "typecheck": "pnpm run build && tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "vue": ">=3.4.0"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "jiti": "^2.6.1",
    "markdown-it": "^14.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@slidev/cli": "52.1.0",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/types": "^52.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.8.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.7.0",
    "jsdom": "^26.1.0",
    "pkg-pr-new": "0.0.79",
    "prettier": "3.9.5",
    "prettier-plugin-slidev": "^1.0.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "^7.1.10",
    "vitest": "^3.1.4",
    "vue": "^3.5.22",
    "vue-tsc": "^3.1.1"
  }
}
